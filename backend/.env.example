# Cadena de conexión a PostgreSQL (formato Prisma)
DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/contaassist?schema=public"

# Servidor
PORT=4000

# Origen permitido para CORS (frontend)
CORS_ORIGIN="http://localhost:5173"

# Autenticación
JWT_SECRET="CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="CAMBIAR_POR_OTRO_SECRETO_LARGO_Y_ALEATORIO_DISTINTO"
JWT_REFRESH_EXPIRES_IN="7d"

# Centro de carga (Fase 6)
STORAGE_DIR="./storage"
CARGA_MAX_ARCHIVO_MB=20
CARGA_MAX_ARCHIVOS=200

# Seed (usuario administrador inicial, solo para entornos de desarrollo)
SEED_ADMIN_EMAIL="admin@contaassist.local"
SEED_ADMIN_PASSWORD="CambiarEnDesarrollo123!"
SEED_EMPRESA_NIT="900000000-1"
SEED_EMPRESA_RAZON_SOCIAL="Empresa Demo ContaAssist"
