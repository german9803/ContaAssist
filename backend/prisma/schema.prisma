// Modelo de datos de ContaAssist — ver /docs/database.md
// Los modelos se agregan de forma incremental por fase (empresas/usuarios en Fase 4,
// documentos en Fase 7, etc.), no se genera el esquema completo de una sola vez.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Fase 3/4: seguridad y organización (ver /docs/database.md §1) ──────────

model Empresa {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nit             String   @unique @db.VarChar(20)
  razonSocial     String   @map("razon_social") @db.VarChar(200)
  nombreComercial String?  @map("nombre_comercial") @db.VarChar(200)
  activa          Boolean  @default(true)
  creadoEn        DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuarioEmpresaRoles UsuarioEmpresaRol[]
  cargas              Carga[]
  archivosOrigen      ArchivoOrigen[]
  auditoria           Auditoria[]
  terceros            Tercero[]
  documentos          Documento[]
  cuentasContables    CuentaContable[]
  centrosCosto        CentroCosto[]
  formasPago          FormaPago[]
  mapeoCuentas        MapeoCuenta[]
  mapeoTerceros       MapeoTercero[]
  mapeoFormasPago     MapeoFormaPago[]

  @@map("empresas")
}

model Rol {
  id     Int    @id @default(autoincrement())
  codigo String @unique @db.VarChar(30) // ADMINISTRADOR, AUXILIAR_CONTABLE, CONTADOR, CONSULTA
  nombre String @db.VarChar(60)

  rolPermisos         RolPermiso[]
  usuarioEmpresaRoles UsuarioEmpresaRol[]

  @@map("roles")
}

model Permiso {
  id     Int    @id @default(autoincrement())
  codigo String @unique @db.VarChar(60) // ej. documento.aprobar, exportacion.generar
  modulo String @db.VarChar(40)

  rolPermisos RolPermiso[]

  @@map("permisos")
}

model RolPermiso {
  rolId     Int @map("rol_id")
  permisoId Int @map("permiso_id")

  rol     Rol     @relation(fields: [rolId], references: [id])
  permiso Permiso @relation(fields: [permisoId], references: [id])

  @@id([rolId, permisoId])
  @@map("rol_permisos")
}

model Usuario {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String    @unique @db.VarChar(150)
  passwordHash   String    @map("password_hash") @db.VarChar(200)
  nombreCompleto String    @map("nombre_completo") @db.VarChar(150)
  activo         Boolean   @default(true)
  ultimoLogin    DateTime? @map("ultimo_login") @db.Timestamptz(6)
  creadoEn       DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)

  empresaRoles UsuarioEmpresaRol[]
  cargas       Carga[]
  auditoria    Auditoria[]

  @@map("usuarios")
}

model UsuarioEmpresaRol {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String  @map("usuario_id") @db.Uuid
  empresaId String  @map("empresa_id") @db.Uuid
  rolId     Int     @map("rol_id")
  activo    Boolean @default(true)

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  empresa Empresa @relation(fields: [empresaId], references: [id])
  rol     Rol     @relation(fields: [rolId], references: [id])

  @@unique([usuarioId, empresaId]) // un usuario tiene un único rol activo por empresa
  @@index([empresaId, usuarioId])
  @@map("usuario_empresa_rol")
}

// ── Fase 6: Centro de carga (ver /docs/database.md §3) ──────────────────────

model Carga {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId        String    @map("empresa_id") @db.Uuid
  usuarioId        String    @map("usuario_id") @db.Uuid
  tipoOrigen       String    @map("tipo_origen") @db.VarChar(20) // PDF, XML, XLSX, XLS, CSV, JPG, PNG
  cantidadArchivos Int       @map("cantidad_archivos")
  estado           String    @db.VarChar(30) // RECIBIDO, PROCESANDO, PROCESADO, ERROR (ver docs/data-flow.md)
  iniciadoEn       DateTime  @default(now()) @map("iniciado_en") @db.Timestamptz(6)
  finalizadoEn     DateTime? @map("finalizado_en") @db.Timestamptz(6)

  empresa  Empresa         @relation(fields: [empresaId], references: [id])
  usuario  Usuario         @relation(fields: [usuarioId], references: [id])
  archivos ArchivoOrigen[]

  @@index([empresaId, iniciadoEn(sort: Desc)])
  @@map("cargas")
}

model ArchivoOrigen {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cargaId            String  @map("carga_id") @db.Uuid
  empresaId          String  @map("empresa_id") @db.Uuid
  nombreOriginal     String  @map("nombre_original") @db.VarChar(260)
  extension          String  @db.VarChar(10)
  tamanoBytes        BigInt  @map("tamano_bytes")
  hashSha256         String  @map("hash_sha256") @db.Char(64)
  rutaAlmacenamiento String  @map("ruta_almacenamiento") @db.VarChar(400)
  estado             String  @db.VarChar(30) // RECIBIDO, PROCESANDO, PROCESADO, ERROR
  mensajeError       String? @map("mensaje_error") @db.VarChar(1000)

  carga   Carga   @relation(fields: [cargaId], references: [id])
  empresa Empresa @relation(fields: [empresaId], references: [id])

  documentos Documento[]

  @@unique([empresaId, hashSha256]) // detecta archivo duplicado dentro de la misma empresa
  @@map("archivos_origen")
}

// ── Fase 7: documentos y procesamiento (ver /docs/database.md §2 y §4) ──────
//
// Alcance de esta fase: solo las tablas que los parsers de CSV/XLSX/XLS/XML/PDF
// ya pueden poblar de verdad. `documento_detalles`, `retenciones` y las FK a
// cuenta_contable/centro_costo/forma_pago quedan para cuando existan esos
// catálogos (Fase 9/11) — no tiene sentido crear columnas que nadie llena aún.

model Tercero {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId          String  @map("empresa_id") @db.Uuid
  tipoIdentificacion String  @map("tipo_identificacion") @db.VarChar(10) // NIT, CC, CE, PAS
  identificacion     String  @db.VarChar(20)
  dv                 String? @db.Char(1)
  razonSocial        String  @map("razon_social") @db.VarChar(200)
  tipoTercero        String  @map("tipo_tercero") @db.VarChar(20) // CLIENTE, PROVEEDOR, AMBOS, OTRO
  email              String? @db.VarChar(150)
  telefono           String? @db.VarChar(30)
  ciudad             String? @db.VarChar(80)
  activo             Boolean @default(true)

  empresa    Empresa        @relation(fields: [empresaId], references: [id])
  documentos Documento[]
  mapeos     MapeoTercero[]

  @@unique([empresaId, tipoIdentificacion, identificacion])
  @@index([empresaId, tipoTercero])
  @@map("terceros")
}

model Documento {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId        String    @map("empresa_id") @db.Uuid
  archivoOrigenId  String?   @map("archivo_origen_id") @db.Uuid // null si es entrada manual futura
  tipoDocumento    String    @map("tipo_documento") @db.VarChar(30) // FACTURA_COMPRA, FACTURA_VENTA, NOTA_CREDITO, NOTA_DEBITO, EXTRACTO_BANCARIO, OTRO
  numeroDocumento  String?   @map("numero_documento") @db.VarChar(50)
  prefijo          String?   @db.VarChar(10)
  fechaEmision     DateTime? @map("fecha_emision") @db.Date
  fechaVencimiento DateTime? @map("fecha_vencimiento") @db.Date
  terceroId        String?   @map("tercero_id") @db.Uuid
  cuentaContableId String?   @map("cuenta_contable_id") @db.Uuid
  centroCostoId    String?   @map("centro_costo_id") @db.Uuid
  formaPagoId      String?   @map("forma_pago_id") @db.Uuid
  subtotal         Decimal?  @db.Decimal(18, 2)
  totalImpuestos   Decimal?  @map("total_impuestos") @db.Decimal(18, 2)
  totalRetenciones Decimal?  @map("total_retenciones") @db.Decimal(18, 2)
  total            Decimal?  @db.Decimal(18, 2)
  moneda           String    @default("COP") @db.Char(3)
  estado           String    @db.VarChar(30) // ver docs/data-flow.md
  textoExtraido    String?   @map("texto_extraido") // texto plano de PDF, para revisión manual (sin OCR/IA)
  observaciones    String?   @db.VarChar(1000)
  creadoEn         DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)

  empresa        Empresa         @relation(fields: [empresaId], references: [id])
  archivoOrigen  ArchivoOrigen?  @relation(fields: [archivoOrigenId], references: [id])
  tercero        Tercero?        @relation(fields: [terceroId], references: [id])
  cuentaContable CuentaContable? @relation(fields: [cuentaContableId], references: [id])
  centroCosto    CentroCosto?    @relation(fields: [centroCostoId], references: [id])
  formaPago      FormaPago?      @relation(fields: [formaPagoId], references: [id])
  impuestos      DocumentoImpuesto[]
  validaciones   DocumentoValidacion[]

  @@index([empresaId, estado])
  @@index([empresaId, terceroId])
  @@map("documentos")
}

model Impuesto {
  id         Int     @id @default(autoincrement())
  codigo     String  @unique @db.VarChar(20) // IVA_19, IVA_5, IVA_0, INC
  nombre     String  @db.VarChar(60)
  porcentaje Decimal @db.Decimal(6, 3)

  documentoImpuestos DocumentoImpuesto[]

  @@map("impuestos")
}

model DocumentoImpuesto {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentoId String  @map("documento_id") @db.Uuid
  impuestoId  Int     @map("impuesto_id")
  base        Decimal @db.Decimal(18, 2)
  valor       Decimal @db.Decimal(18, 2)

  documento Documento @relation(fields: [documentoId], references: [id])
  impuesto  Impuesto  @relation(fields: [impuestoId], references: [id])

  @@index([documentoId])
  @@map("documento_impuestos")
}

// ── Fase 8: motor de validaciones (ver /docs/validation-engine.md, database.md §7)
//
// Reglas ya implementables ahora: campos obligatorios, fecha, total cuadrado,
// tercero identificado, NIT válido, documento duplicado, consistencia de IVA.
// CUENTA_NO_ASIGNADA / CENTRO_COSTO_REQUERIDO / FORMA_PAGO_FALTANTE quedan
// para cuando existan esos catálogos (Fase 9/11) — documento no tiene esos campos aún.

model ReglaValidacion {
  id          Int     @id @default(autoincrement())
  codigo      String  @unique @db.VarChar(60)
  descripcion String  @db.VarChar(300)
  severidad   String  @db.VarChar(20) // BLOQUEANTE, ADVERTENCIA
  activa      Boolean @default(true)

  documentoValidaciones DocumentoValidacion[]

  @@map("reglas_validacion")
}

model DocumentoValidacion {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentoId String   @map("documento_id") @db.Uuid
  reglaId     Int      @map("regla_id")
  resultado   String   @db.VarChar(20) // OK, FALLA
  mensaje     String?  @db.VarChar(500)
  evaluadoEn  DateTime @default(now()) @map("evaluado_en") @db.Timestamptz(6)

  documento Documento       @relation(fields: [documentoId], references: [id])
  regla     ReglaValidacion @relation(fields: [reglaId], references: [id])

  @@index([documentoId, evaluadoEn(sort: Desc)])
  @@map("documento_validaciones")
}

// ── Fase 11: catálogos contables y mapeo de datos (ver /docs/database.md §5-6)
//
// Cierra el hueco dejado a propósito en Fase 7/8: documentos.cuenta_contable_id
// / centro_costo_id / forma_pago_id ahora sí tienen a qué apuntar, y las 3
// reglas de validación pendientes de Fase 8 (CUENTA_NO_ASIGNADA,
// CENTRO_COSTO_REQUERIDO, FORMA_PAGO_FALTANTE) ya se pueden implementar.

model CuentaContable {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId  String  @map("empresa_id") @db.Uuid
  codigo     String  @db.VarChar(20)
  nombre     String  @db.VarChar(150)
  naturaleza String  @db.VarChar(10) // DEBITO, CREDITO
  activa     Boolean @default(true)

  empresa    Empresa       @relation(fields: [empresaId], references: [id])
  documentos Documento[]
  mapeos     MapeoCuenta[]

  @@unique([empresaId, codigo])
  @@map("cuentas_contables")
}

model CentroCosto {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId String  @map("empresa_id") @db.Uuid
  codigo    String  @db.VarChar(20)
  nombre    String  @db.VarChar(150)
  activo    Boolean @default(true)

  empresa    Empresa     @relation(fields: [empresaId], references: [id])
  documentos Documento[]

  @@unique([empresaId, codigo])
  @@map("centros_costo")
}

model FormaPago {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId String @map("empresa_id") @db.Uuid
  codigo    String @db.VarChar(20)
  nombre    String @db.VarChar(80)

  empresa    Empresa          @relation(fields: [empresaId], references: [id])
  documentos Documento[]
  mapeos     MapeoFormaPago[]

  @@unique([empresaId, codigo])
  @@map("formas_pago")
}

model SistemaDestino {
  id                    Int     @id @default(autoincrement())
  codigo                String  @unique @db.VarChar(30) // WORDOFFICE, SIIGO, EXCEL, CSV
  nombre                String  @db.VarChar(80)
  versionFormatoActual  String? @map("version_formato_actual") @db.VarChar(20)

  mapeoCuentas    MapeoCuenta[]
  mapeoTerceros   MapeoTercero[]
  mapeoFormasPago MapeoFormaPago[]

  @@map("sistemas_destino")
}

model MapeoCuenta {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId        String @map("empresa_id") @db.Uuid
  sistemaDestinoId Int    @map("sistema_destino_id")
  cuentaContableId String @map("cuenta_contable_id") @db.Uuid
  codigoDestino    String @map("codigo_destino") @db.VarChar(50)

  empresa        Empresa        @relation(fields: [empresaId], references: [id])
  sistemaDestino SistemaDestino @relation(fields: [sistemaDestinoId], references: [id])
  cuentaContable CuentaContable @relation(fields: [cuentaContableId], references: [id])

  @@unique([empresaId, sistemaDestinoId, cuentaContableId])
  @@map("mapeo_cuentas")
}

model MapeoTercero {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId        String @map("empresa_id") @db.Uuid
  sistemaDestinoId Int    @map("sistema_destino_id")
  terceroId        String @map("tercero_id") @db.Uuid
  codigoDestino    String @map("codigo_destino") @db.VarChar(50)

  empresa        Empresa        @relation(fields: [empresaId], references: [id])
  sistemaDestino SistemaDestino @relation(fields: [sistemaDestinoId], references: [id])
  tercero        Tercero        @relation(fields: [terceroId], references: [id])

  @@unique([empresaId, sistemaDestinoId, terceroId])
  @@map("mapeo_terceros")
}

model MapeoFormaPago {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId        String @map("empresa_id") @db.Uuid
  sistemaDestinoId Int    @map("sistema_destino_id")
  formaPagoId      String @map("forma_pago_id") @db.Uuid
  codigoDestino    String @map("codigo_destino") @db.VarChar(50)

  empresa        Empresa        @relation(fields: [empresaId], references: [id])
  sistemaDestino SistemaDestino @relation(fields: [sistemaDestinoId], references: [id])
  formaPago      FormaPago      @relation(fields: [formaPagoId], references: [id])

  @@unique([empresaId, sistemaDestinoId, formaPagoId])
  @@map("mapeo_formas_pago")
}

// ── Auditoría (sección 23) ───────────────────────────────────────────────────

model Auditoria {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId     String   @map("empresa_id") @db.Uuid
  usuarioId     String   @map("usuario_id") @db.Uuid
  accion        String   @db.VarChar(60) // ej. CARGAR_ARCHIVOS, MODIFICAR_DOCUMENTO
  entidad       String   @db.VarChar(60) // ej. carga, documento
  entidadId     String?  @map("entidad_id") @db.Uuid
  campo         String?  @db.VarChar(60)
  valorAnterior String?  @map("valor_anterior")
  valorNuevo    String?  @map("valor_nuevo")
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  empresa Empresa @relation(fields: [empresaId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([empresaId, creadoEn(sort: Desc)])
  @@index([entidad, entidadId])
  @@map("auditoria")
}
